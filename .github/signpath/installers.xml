<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de artefacto de SignPath (slug: "installers").
  SignPath no la lee del repo: hay que pegarla en
  Project > Artifact configurations > installers > Edit.

  El artefacto lo sube el workflow de release (artefacto "windows-unsigned")
  con nombres fijos para que esta configuración no dependa de la versión.
  El workflow pasa el parámetro "version" (la de src-tauri/tauri.conf.json).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- Metadatos que pone Tauri en el instalador NSIS (comprobado en la v1.8.1) -->
    <pe-file path="KB-MC-Launcher-setup.exe" product-name="KB MC Launcher" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="KB-MC-Launcher.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
