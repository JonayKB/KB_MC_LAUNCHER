{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the game log windows",
  "windows": [
    "main",
    "logs-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "process:allow-restart",
    "process:allow-exit",
    "updater:default",
    "dialog:default",
    "shell:allow-open"
  ]
}
